{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "linux_app: configure (host)",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "cmake",
        "-S",
        "linux_app",
        "-B",
        "build/linux_app-host"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "linux_app: compile (host)",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "cmake",
        "--build",
        "build/linux_app-host"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "linux_app: configure (host)"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "linux_app: configure (Duo RISC-V)",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "cmake",
        "-S",
        "linux_app",
        "-B",
        "build/linux_app-duo",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/nix/riscv64-linux-toolchain.cmake"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
