    {
      "label": "clangd: refresh compile databases",
      "type": "shell",
      "command": "echo",
      "args": [
        "clangd compile databases refreshed."
      ],
      "dependsOn": [
        "linux_app: configure (host)",
        "rtos_firmware: configure (Duo RTOS)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "all: build (host)",
      "type": "shell",
      "command": "echo",
      "args": [
        "Host build finished."
      ],
      "dependsOn": [
        "linux_app: compile (host)",
        "rtos_firmware: compile (host)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "all: build (Duo)",
